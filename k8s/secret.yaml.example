apiVersion: v1
kind: Secret
metadata:
  name: codebase-secret
  namespace: codebase
  labels:
    app: codebase
type: Opaque
stringData:
  # next-auth — required. Generate with: openssl rand -base64 32
  NEXTAUTH_SECRET: "REPLACE_ME_WITH_OPENSSL_RAND_BASE64_32"

  # next-auth URL — must match the public hostname used in Ingress.
  # Example: https://app.example.com
  NEXTAUTH_URL: "https://REPLACE_ME_WITH_PUBLIC_HOSTNAME"

  # Optional: if you wire external OAuth providers, add them here.
  # GITHUB_ID: ""
  # GITHUB_SECRET: ""
